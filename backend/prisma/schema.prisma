// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// users will be automatically generated when they open the site, the key is generated and they can use this between devices if they'd like.
model User {
  id  String @id @default(cuid())
  key String @unique @default(cuid())

  name String

  mashedSongs MashedSong[]
  jobs        Job[]
}

model Job {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  jobIds        String[]
  title         String
  status        String   @default("processing")
  totalJobs     Int      @default(2)
  completedJobs Int      @default(0)
  results       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  JobIdToRealName Json

  @@index([userId])
  @@index([status])
}

/**
 * vocalURL: songOne?.useVocals ? songOne.vocalUrl : songTwo?.vocalUrl,
 * instrumentalURL: songOne?.useInstrumentals ? songOne.instrumentalUrl : songTwo?.instrumentalUrl,
 * vocalVolume: songOne?.useVocals ? songOne.volume : songTwo?.volume,
 * instrumentalVolume: songOne?.useInstrumentals ? songOne.volume : songTwo?.volume,
 * title: mixRes.job.title,
 */

model MashedSong {
  id    String @id @default(cuid())
  title String

  instrumentalURL String
  vocalURL       String
  vocalVolume    Float
  instrumentalVolume Float

  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}
